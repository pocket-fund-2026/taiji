# Email settings for Shaadi OS. Copy these into the server's private environment (never commit real values).
# With no SMTP_HOST / MAIL_FROM the app sends nothing and everything else keeps working.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false            # true for port 465
SMTP_USER=replace-me
SMTP_PASS=replace-me
MAIL_FROM="Shaadi OS <no-reply@your-domain.example>"
SITE_URL=https://46-225-26-58.sslip.io   # base for links inside emails (RSVP etc.)
GRIEVANCE_OFFICER_EMAIL=officer@your-domain.example   # receives grievance / listing-removal alerts
EMAIL_OTP_ENABLED=0          # 1 turns on sign-in by emailed code (needs SMTP configured)
