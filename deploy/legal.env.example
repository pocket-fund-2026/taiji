# Company and officer details shown on /privacy, /terms, /grievance and the other legal pages.
# Fill these in, add them to the server's environment (never commit real values), and restart the API.
COMPANY_NAME="<registered legal name>"
COMPANY_ADDRESS="<registered office address, city, state, PIN>"
COMPANY_CIN="<CIN or LLPIN>"
COMPANY_GSTIN="<15-character GSTIN>"
GRIEVANCE_OFFICER_NAME="<full name of the officer>"
GRIEVANCE_OFFICER_TITLE="<designation>"
GRIEVANCE_OFFICER_EMAIL="<monitored email>"
GRIEVANCE_OFFICER_PHONE="<phone and hours, e.g. +91 ..., Mon-Sat 10:00-18:00 IST>"
# Admin access (see docs/SECURITY-RUNBOOK.md)
ADMIN_PHONES="<your mobile number>"
ADMIN_OTP="<long random secret, only you know>"
