{
  "expo": {
    "name": "Shaadi OS",
    "slug": "shaadi-os",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/brand-icon-v3.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/brand-icon-v3.png",
      "resizeMode": "contain",
      "backgroundColor": "#74263F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shaadios.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Taiji connects to your planning server on the local network to load vendors and your checklist.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ]
      },
      "buildNumber": "12"
    },
    "android": {
      "package": "com.shaadios.app",
      "adaptiveIcon": {
        "backgroundColor": "#74263F",
        "foregroundImage": "./assets/android-icon-foreground-v3.png"
      },
      "versionCode": 5,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose portfolio photos to show couples on your Shaadi OS storefront.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Shaadi OS",
      "shortName": "Shaadi OS",
      "backgroundColor": "#FBF6F1",
      "themeColor": "#7A1F3D",
      "favicon": "./assets/favicon-v3.png"
    }
  }
}
